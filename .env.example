# Server Configuration
HOST=127.0.0.1
PORT=5000
DEBUG=True

# MQTT Security & Virtual Network Settings
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=8883
MQTT_TOPIC=gridguard/telemetry
MQTT_CLIENT_ID=gridguard_edge_sim
MQTT_USER=admin
MQTT_PASSWORD=your_secure_password_here

# Database Connection
DATABASE_URL=sqlite:///gridguard.db

# AI Detection Engine Heuristics
VOLTAGE_UPPER_LIMIT=240.0
VOLTAGE_LOWER_LIMIT=210.0
CURRENT_THRESHOLD_AMPS=25.0
TEMP_THRESHOLD_CELSIUS=75.0
